import pandas as pd
from snakemake.exceptions import WorkflowError

configfile: "config/config.yaml"

OUTDIR = config["outdir"]

# R (and any other) jobs default their own tempdir (e.g. R's tempdir(), used
# by data.table/maftools when reading large gzipped MAFs) to /tmp, which on
# many clusters is a small-quota tmpfs - large WGS MAFs can exhaust it and
# fail with "Disk quota exceeded" even though the real output filesystem has
# plenty of room. Route job tempdirs through the same configurable tmp_dir
# already used by vcf2maf's shell script, via Snakemake's special "tmpdir"
# resource (sets TMPDIR/TMP/TEMP for the job).
R_TMPDIR = config.get("tmp_dir") or "/tmp"


wildcard_constraints:
    contrast=r"[^/]+",
    caller=r"[A-Za-z0-9_]+",


def get_contrasts_df():
    """Read the (contrast, caller) table produced by the discover_contrasts
    checkpoint. Cached per Snakemake invocation is unnecessary here since the
    file is small; re-reading keeps this simple and always up to date."""
    cp = checkpoints.discover_contrasts.get()
    df = pd.read_csv(cp.output.tsv, sep="\t", dtype=str)
    df["normal_id"] = df["normal_id"].fillna("")
    return df


def get_cnv_df():
    """Read the (contrast, cns_path) table produced by the discover_contrasts
    checkpoint's CNVkit discovery. Rows with no cns_path found are dropped."""
    cp = checkpoints.discover_contrasts.get()
    df = pd.read_csv(cp.output.cnv_tsv, sep="\t", dtype=str)
    df["genemetrics_path"] = df["genemetrics_path"].fillna("")
    return df[df["cns_path"].notna() & (df["cns_path"] != "")]


