def get_all_targets(wildcards):
    targets = [
        f"{OUTDIR}/oncoplots/cohort/.done",
        f"{OUTDIR}/drivers/cohort_ranked_drivers.tsv",
    ]
    if config.get("signatures", {}).get("enabled", False):
        targets.append(f"{OUTDIR}/signatures/cohort/.done")
    if config.get("sv_analysis", {}).get("enabled", False):
        targets += all_manta_sv_tsvs(wildcards)
    if config.get("cnv", {}).get("enabled", False):
        targets.append(f"{OUTDIR}/cnv/cohort/cnv_heatmap.pdf")
    if config.get("actionability", {}).get("enabled", False):
        targets.append(f"{OUTDIR}/actionability/actionability_report.tsv")
    return targets


